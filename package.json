{
  "name": "@choi-p/dsh-footer-order",
  "version": "0.3.0",
  "description": "DSH web sidebar foot ordering: force the sidebar.footer.action slot into a vertical stack (display: contents → flex column) and configure the top-to-bottom order of its entries — including the shell's settings row (settingsArea) under the reserved id `settings`.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sidebar",
    "footer",
    "settings",
    "order",
    "layout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Choi-Peng/dsh-footer-order.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-settings": { "optional": false },
    "@deepseek-ai/schemastery": { "optional": false }
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
